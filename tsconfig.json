{
  "compilerOptions": {
    "target": "ES2017",
    "module": "preserve",
    "moduleResolution": "bundler",

    "strict": true,
    "experimentalDecorators": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "jsx": "react-jsx"
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
