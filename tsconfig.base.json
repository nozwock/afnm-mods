{
  "compilerOptions": {
    "target": "ES2017",
    "experimentalDecorators": true,
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "inlineSourceMap": false,
    "preserveConstEnums": true,
    "removeComments": false,
    "jsx": "react-jsx"
  },
  "include": ["src/**/*", "../../*.d.ts"],
  "exclude": ["node_modules"]
}
